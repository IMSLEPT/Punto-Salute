<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: splash di sistema esplicita (sfondo bianco + logo dell'app), cosi' non viene usata l'icona monocromatica/tematizzata -->
    <style name="Theme.PuntoSalute" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/ps_white</item>
        <item name="android:navigationBarColor">@color/ps_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/ps_white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
